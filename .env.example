# Copie para `.env` na raiz do projeto e reinicie `npm run dev` (Vite só lê .env no start).

# ---------------------------------------------------------------------------
# OPÇÃO A — Supabase LOCAL (supabase CLI: `supabase start`)
# Rode no terminal:  npx supabase status
# Copie "API URL" e "anon key" exatamente como aparecem.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole_aqui_o_anon_key_do_supabase_status

# ---------------------------------------------------------------------------
# OPÇÃO B — Supabase na NUVEM (dashboard.supabase.com → seu projeto → Settings → API)
# Project URL + anon public
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
